<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings rows: white when focused (the text turns dark, color/settings_row_text), a green edge on
     the chosen value, a quiet card otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF2F5F8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#334DAE6D" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FF4DAE6D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C232C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
