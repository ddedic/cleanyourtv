<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings, two panes like the TV's own settings: the title on the left, the rows on the right in
     groups (Home screen, Look, Featured shelf, Remote & power, TV & system). Only the right pane takes focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1217"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.36"
        android:background="#FF141A21"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingEnd="40dp"
        android:paddingTop="72dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/settings_subtitle"
            android:textColor="#FF8A96A3"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.64"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="64dp"
            android:paddingTop="40dp"
            android:paddingBottom="64dp">

            <!-- Home screen -->
            <TextView style="@style/SettingsGroup" android:layout_marginTop="0dp" android:text="@string/settings_group_home" />

            <TextView
                android:id="@+id/reorderChoice"
                style="@style/SettingsRow"
                android:text="@string/reorder" />

            <TextView
                android:id="@+id/dockEditChoice"
                style="@style/SettingsRow"
                android:text="@string/dock_edit"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/columns_label"
                android:textColor="#FFDDE3EA"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/rows_below_dock_label"
                android:textColor="#FFDDE3EA"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/dock_opacity_label"
                android:textColor="#FFDDE3EA"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
            </LinearLayout>

            <!-- Look -->
            <TextView style="@style/SettingsGroup" android:text="@string/settings_group_look" />

            <TextView
                android:id="@+id/wallpaperChoice"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/animationsChoice"
                style="@style/SettingsRow" />

            <TextView
                android:id="@+id/advancedChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/advanced_effects_warning" />

            <TextView
                android:id="@+id/followThemeChoice"
                style="@style/SettingsRow"
                android:text="@string/follow_theme" />

            <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />

            <!-- Featured shelf: only while a feed is set (or switched off here) -->
            <TextView
                android:id="@+id/featuredGroup"
                style="@style/SettingsGroup"
                android:text="@string/settings_group_featured"
                android:visibility="gone" />

            <TextView
                android:id="@+id/featuredChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/featuredTintChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/featuredHint"
                style="@style/SettingsHint"
                android:text="@string/featured_hint"
                android:visibility="gone" />

            <!-- Remote & power -->
            <TextView style="@style/SettingsGroup" android:text="@string/settings_group_remote" />

            <TextView
                android:id="@+id/powerOnHomeChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/powerOnHomeHint"
                style="@style/SettingsHint"
                android:text="@string/power_on_home_hint"
                android:visibility="gone" />

            <TextView
                android:id="@+id/keyFilterChoice"
                style="@style/SettingsRow" />

            <TextView style="@style/SettingsHint" android:text="@string/key_filter_hint" />

            <TextView
                android:id="@+id/openOnStartChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <!-- Remote buttons: Philips only -->
            <TextView
                android:id="@+id/buttonsGroup"
                style="@style/SettingsGroup"
                android:text="@string/settings_group_buttons"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rakutenButtonChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/galleryButtonChoice"
                style="@style/SettingsRow"
                android:visibility="gone" />

            <TextView
                android:id="@+id/buttonsHint"
                style="@style/SettingsHint"
                android:text="@string/buttons_hint"
                android:visibility="gone" />

            <!-- TV & system -->
            <TextView style="@style/SettingsGroup" android:text="@string/settings_group_tv" />

            <TextView
                android:id="@+id/sourcesChoice"
                style="@style/SettingsRow"
                android:text="@string/inputs" />

            <TextView
                android:id="@+id/tvSettingsChoice"
                style="@style/SettingsRow"
                android:text="@string/tv_settings" />

            <TextView
                android:id="@+id/androidSettingsChoice"
                style="@style/SettingsRow"
                android:text="@string/android_settings"
                android:visibility="gone" />

            <TextView
                android:id="@+id/networkChoice"
                style="@style/SettingsRow"
                android:text="@string/network_settings" />

            <TextView
                android:id="@+id/appsChoice"
                style="@style/SettingsRow"
                android:text="@string/apps_settings" />

            <TextView
                android:id="@+id/defaultHomeChoice"
                style="@style/SettingsRow"
                android:text="@string/home_settings" />

            <TextView style="@style/SettingsHint" android:text="@string/home_settings_help" />

            <TextView
                android:id="@+id/originalLauncherChoice"
                style="@style/SettingsRow"
                android:text="@string/original_launcher" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
