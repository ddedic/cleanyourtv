<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The only permission: plex.tv for the sign-in and the server list, and your Plex server for the feed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional, granted over ADB only (pm grant): lets the setup screen switch the TV's screensaver and its wait,
         which Philips firmware offers no other way to reach. Nothing else is written. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- The LEANBACK_LAUNCHER entry also makes this package, and so its provider, visible to the launcher. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screensaver: the cached artwork, slowly zooming and crossfading. Settings > Screensaver picks it. -->
        <service
            android:name=".FeedDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Featured feed (docs/specs/feed.md): titles, text and pictures only; no tokens leave the app. -->
        <provider
            android:name=".FeedProvider"
            android:authorities="io.github.ddedic.plexfeed.feed"
            android:exported="true" />
    </application>
</manifest>
